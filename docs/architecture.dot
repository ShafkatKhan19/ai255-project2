digraph snip {
  rankdir=LR; bgcolor="#fbf5ec"; pad=0.4; nodesep=0.45; ranksep=0.9;
  fontname="Helvetica"; labelloc=t; fontsize=20; fontcolor="#161616";
  label="Snip on Google Cloud (us-central1)";
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#161616", fontname="Helvetica", fontsize=12, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#161616", fontcolor="#6d655a"];

  user [label="Browser", fillcolor="#161616", fontcolor="#fbf5ec"];
  dev  [label="My PC\ndocker build / push\nkubectl apply", fillcolor="#161616", fontcolor="#fbf5ec"];

  subgraph cluster_gcp {
    label="Google Cloud project"; labelloc=t; fontsize=13; style="rounded,dashed"; color="#6d655a"; fontcolor="#6d655a";

    lb [label="HTTPS load balancer (Ingress)\nGoogle-managed certificate\nHTTP redirects to HTTPS\n\n+ plain HTTP load balancer\non the first address", fillcolor="#ffe3dd", color="#ff5a45"];

    subgraph cluster_gke {
      label="GKE Autopilot cluster  /  namespace snip"; labelloc=t; fontsize=13; style="rounded,filled"; fillcolor="#f4ead9"; color="#161616"; fontcolor="#161616";
      web   [label="web\n2 to 6 pods (HPA, 60% CPU)\npage + gateway\nliveness /healthz, readiness /readyz", color="#ff5a45", penwidth=2];
      links [label="links\n2 to 6 pods (HPA)\ncreate / look up links\nreadiness checks Firestore"];
      stats [label="stats\n2 to 6 pods (HPA)\ncount clicks\nreadiness checks Firestore"];
      np    [label="NetworkPolicy:\nlinks and stats accept\ntraffic from web only", shape=note, fillcolor="#fff8d6", fontsize=10];
    }

    fs  [label="Firestore\n(managed datastore)\ncollections: links, clicks", shape=cylinder, fillcolor="#ffe3dd", color="#ff5a45"];
    ar  [label="Artifact Registry\nimages: web, links, stats", shape=folder];
    iam [label="IAM (Workload Identity)\nsnip-data -> roles/datastore.user\nsnip-web  -> no cloud access", shape=note, fillcolor="#fff8d6", fontsize=10];
  }

  user -> lb    [label="HTTPS", color="#ff5a45", penwidth=1.8];
  lb -> web     [color="#ff5a45", penwidth=1.8];
  web -> links  [label="http://links:8080\n4 s timeout, GET retried once"];
  web -> stats  [label="http://stats:8080\n1 s timeout, best effort"];
  links -> fs   [label="read / create"];
  stats -> fs   [label="atomic increment"];
  dev -> ar     [label="push images", style=dashed];
  ar -> web     [label="pull", style=dashed, constraint=false];
  iam -> fs     [style=dotted, arrowhead=none];
  np -> links   [style=dotted, arrowhead=none, constraint=false];
}
